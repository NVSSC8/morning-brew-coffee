# ============================================================
# Aurora Morning Brew - Environment Variables Template
# Copy this file to .env for local overrides
# ============================================================

# Flask Settings
FLASK_ENV=development
SECRET_KEY=morning-brew-super-secure-session-key-dawn-2026
PORT=5000

# 1. Option A: Local SQLite (Leave DATABASE_URL blank or use sqlite)
# DATABASE_URL=sqlite:///coffee_shop.db

# 2. Option B: AWS RDS PostgreSQL or Docker Postgres
# DATABASE_URL=postgresql://coffee_user:your_db_password@your-rds-endpoint.us-east-1.rds.amazonaws.com:5432/coffee_db

# 3. Option C: AWS Secrets Manager (Auto-retrieves DB credentials)
# AWS_SECRET_NAME=aurora/morning-brew/db-credentials
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_access_key (or use EC2/EKS IAM Role)
# AWS_SECRET_ACCESS_KEY=your_secret_key
